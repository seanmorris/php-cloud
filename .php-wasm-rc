#!/usr/bin/env php-wasm

VRZNO_DEV_PATH=~/projects/vrzno
PDO_CFD1_DEV_PATH=~/projects/pdo-cfd1
PHP_VERSION=8.3
ASSERTIONS=0
SYMBOLS=2
WITH_SOURCEMAPS=0
OPTIMIZE=2

MAIN_MODULE=0
ASYNCIFY=1

GZIP=1
BROTLI=1

WITH_VRZNO=1
WITH_PDO_CFD1=1
WITH_PDO_PGLITE=0
WITH_LIBZIP=static

WITH_BCMATH=0
WITH_CALENDAR=0
WITH_CTYPE=0
WITH_FILTER=0
WITH_TOKENIZER=0
WITH_EXIF=0

WITH_PHAR=0

WITH_LIBXML=0
WITH_DOM=0
WITH_XML=0
WITH_SIMPLEXML=0

WITH_ICONV=0
WITH_SQLITE=0

WITH_GD=0
WITH_ZLIB=0
WITH_LIBPNG=0
WITH_FREETYPE=0
WITH_LIBJPEG=0
WITH_LIBWEBP=0

WITH_YAML=0
WITH_TIDY=0
WITH_MBSTRING=0
WITH_ONIGURUMA=0
WITH_OPENSSL=0
WITH_INTL=0
